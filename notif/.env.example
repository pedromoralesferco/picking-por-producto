# Copiar como .env en la carpeta de la tarea (C:\SACWhatsappSync) y llenar.
# El .env real NO se sube a git.

# SQL Server: Picking_Management (los SPs leen SAP por el linked server)
NOTIF_DB_SERVER=SERVER-APPS-TAB
NOTIF_DB_NAME=Picking_Management
NOTIF_DB_USER=
NOTIF_DB_PASSWORD=

# Supabase (proyecto SAC_FERCO). Llave secreta / service_role:
# Project Settings -> API Keys. No compartirla ni pegarla en chats.
NOTIF_SUPABASE_URL=https://fhefwggpiumjtcnqixsb.supabase.co
NOTIF_SUPABASE_KEY=

# pais:baseSAP:almacenes (varios almacenes con +, ej. GT:sboferco:138+01).
# Sin almacenes = todos los de ese pais. Agregar SV y HN cuando esten validados.
NOTIF_PAISES=GT:sboferco:138

# 0 = todos los tipos de entrega (default); 1 = solo entrega en RUTA (TrnspCode=22)
NOTIF_SOLO_RUTA=0
