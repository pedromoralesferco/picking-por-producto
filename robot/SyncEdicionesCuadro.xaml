<Activity mc:Ignorable="sap sap2010" x:Class="SyncEdicionesCuadro" sap2010:ExpressionActivityEditor.ExpressionActivityEditor="C#" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mca="clr-namespace:Microsoft.CSharp.Activities;assembly=System.Activities" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:s1="clr-namespace:SAPbobsCOM;assembly=Interop.SAPbobsCOM" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Activities</x:String>
      <x:String>SAPbobsCOM</x:String>
      <x:String>UiPath.Database</x:String>
      <x:String>UiPath.Database.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>Interop.SAPbobsCOM</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.CSharp</AssemblyReference>
      <AssemblyReference>UiPath.Database.Activities</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="SyncEdicionesCuadro (PLACA)">
    <Sequence.Variables>
      <Variable x:TypeArguments="s1:Company" Name="ocompany" />
      <Variable x:TypeArguments="x:String" Name="errorCode" />
      <!-- TODO: reemplazar por tu cadena real o leerla de un Config/Asset. Usar un
           login SQL con acceso a Picking_Management Y al linked server [server-sql]. -->
      <Variable x:TypeArguments="x:String" Name="strConn" Default="Server=SERVER-APPS-TAB;Database=Picking_Management;User Id=__SQL_USER__;Password=__SQL_PASS__;TrustServerCertificate=True;" />
      <Variable x:TypeArguments="ui:DatabaseConnection" Name="dbApp" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtPend" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtCreate" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtLineas" />
      <Variable x:TypeArguments="x:Int32" Name="realDocNum" />
      <Variable x:TypeArguments="x:String" Name="strOutCode" />
      <Variable x:TypeArguments="x:String" Name="strErrMsg" />
    </Sequence.Variables>

    <!-- 1) Conexión a SQL (outbox del app) -->
    <ui:DatabaseConnect DisplayName="Conectar SQL (Picking_Management)" ProviderName="System.Data.SqlClient">
      <ui:DatabaseConnect.ConnectionString>
        <InArgument x:TypeArguments="x:String">
          <mca:CSharpValue x:TypeArguments="x:String">strConn</mca:CSharpValue>
        </InArgument>
      </ui:DatabaseConnect.ConnectionString>
      <ui:DatabaseConnect.DatabaseConnection>
        <OutArgument x:TypeArguments="ui:DatabaseConnection">
          <mca:CSharpReference x:TypeArguments="ui:DatabaseConnection">dbApp</mca:CSharpReference>
        </OutArgument>
      </ui:DatabaseConnect.DatabaseConnection>
    </ui:DatabaseConnect>

    <!-- 2) Instanciar y conectar a SAP (DI-API). Reemplazar credenciales o pegar tu bloque "Conectarse". -->
    <Assign DisplayName="ocompany = new Company()">
      <Assign.To>
        <OutArgument x:TypeArguments="s1:Company">
          <mca:CSharpReference x:TypeArguments="s1:Company">ocompany</mca:CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s1:Company">
          <mca:CSharpValue x:TypeArguments="s1:Company">new SAPbobsCOM.Company()</mca:CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>

    <ui:InvokeCode DisplayName="Conectarse SAP (PRD)" Language="CSharp" Code="ocompany.DbServerType = SAPbobsCOM.BoDataServerTypes.dst_MSSQL2014;&#xA;ocompany.DbUserName = &quot;__DB_USER__&quot;;&#xA;ocompany.DbPassword = &quot;__DB_PASS__&quot;;&#xA;ocompany.UserName = &quot;__SAP_USER__&quot;;&#xA;ocompany.Password = &quot;__SAP_PASS__&quot;;&#xA;ocompany.CompanyDB = &quot;SBOFERCO&quot;;&#xA;ocompany.Server = &quot;server-sql.ferco.com.gt&quot;;&#xA;ocompany.SLDServer = &quot;https://server-sapbo.ferco.com.gt:40000&quot;;&#xA;ocompany.Connect();&#xA;errorCode = ocompany.GetLastErrorDescription();">
      <ui:InvokeCode.Arguments>
        <InOutArgument x:TypeArguments="s1:Company" x:Key="ocompany">
          <mca:CSharpReference x:TypeArguments="s1:Company">ocompany</mca:CSharpReference>
        </InOutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="errorCode">
          <mca:CSharpReference x:TypeArguments="x:String">errorCode</mca:CSharpReference>
        </OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>

    <!-- 2b) CREAR complementos primero (cuadro nuevo con sus líneas) y remapear -->
    <ui:ExecuteQuery CommandType="Text" DisplayName="Leer complementos a crear" Sql="SELECT ID_Edicion, RouteNumber FROM dbo.vw_CuadroEdicionPendiente WHERE Accion = 'CREATE' ORDER BY ID_Edicion">
      <ui:ExecuteQuery.DataTable>
        <OutArgument x:TypeArguments="sd:DataTable"><mca:CSharpReference x:TypeArguments="sd:DataTable">dtCreate</mca:CSharpReference></OutArgument>
      </ui:ExecuteQuery.DataTable>
      <ui:ExecuteQuery.ExistingDbConnection>
        <InArgument x:TypeArguments="ui:DatabaseConnection"><mca:CSharpValue x:TypeArguments="ui:DatabaseConnection">dbApp</mca:CSharpValue></InArgument>
      </ui:ExecuteQuery.ExistingDbConnection>
      <ui:ExecuteQuery.Parameters><scg:Dictionary x:TypeArguments="x:String, Argument" /></ui:ExecuteQuery.Parameters>
    </ui:ExecuteQuery>

    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DisplayName="Crear cada complemento">
      <ui:ForEachRow.DataTable>
        <InArgument x:TypeArguments="sd:DataTable"><mca:CSharpValue x:TypeArguments="sd:DataTable">dtCreate</mca:CSharpValue></InArgument>
      </ui:ForEachRow.DataTable>
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument><DelegateInArgument x:TypeArguments="sd:DataRow" Name="cc" /></ActivityAction.Argument>
          <Sequence DisplayName="Body complemento">
            <Assign DisplayName="reset outcome">
              <Assign.To><OutArgument x:TypeArguments="x:String"><mca:CSharpReference x:TypeArguments="x:String">strOutCode</mca:CSharpReference></OutArgument></Assign.To>
              <Assign.Value><InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">&quot;&quot;</mca:CSharpValue></InArgument></Assign.Value>
            </Assign>

            <!-- Líneas del complemento provisional -->
            <ui:ExecuteQuery CommandType="Text" DisplayName="Leer líneas del complemento">
              <ui:ExecuteQuery.Sql>
                <InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String" xml:space="preserve">"SELECT NombreRuta, AlmacenOrigen, OV_Number, DocType, Peso, CodigoCliente, Direccion, Asesor FROM dbo.vw_ComplementoLineas WHERE RouteNumber=" + cc["RouteNumber"].ToString()</mca:CSharpValue></InArgument>
              </ui:ExecuteQuery.Sql>
              <ui:ExecuteQuery.DataTable>
                <OutArgument x:TypeArguments="sd:DataTable"><mca:CSharpReference x:TypeArguments="sd:DataTable">dtLineas</mca:CSharpReference></OutArgument>
              </ui:ExecuteQuery.DataTable>
              <ui:ExecuteQuery.ExistingDbConnection>
                <InArgument x:TypeArguments="ui:DatabaseConnection"><mca:CSharpValue x:TypeArguments="ui:DatabaseConnection">dbApp</mca:CSharpValue></InArgument>
              </ui:ExecuteQuery.ExistingDbConnection>
              <ui:ExecuteQuery.Parameters><scg:Dictionary x:TypeArguments="x:String, Argument" /></ui:ExecuteQuery.Parameters>
            </ui:ExecuteQuery>

            <!-- Crear el cuadro UDO en SAP y obtener el DocNum real -->
            <ui:InvokeCode DisplayName="Crear complemento (UDO)" Language="CSharp" Code="try {&#xA;if (dtLineas == null || dtLineas.Rows.Count == 0) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Complemento sin lineas&quot;; }&#xA;else {&#xA;string Nombre = Convert.ToString(dtLineas.Rows[0][&quot;NombreRuta&quot;]);&#xA;string Almacen = Convert.ToString(dtLineas.Rows[0][&quot;AlmacenOrigen&quot;]);&#xA;SAPbobsCOM.GeneralService gs = ocompany.GetCompanyService().GetGeneralService(&quot;Cuadro_ruta&quot;);&#xA;SAPbobsCOM.GeneralData gd = (SAPbobsCOM.GeneralData)gs.GetDataInterface(SAPbobsCOM.GeneralServiceDataInterfaces.gsGeneralData);&#xA;gd.SetProperty(&quot;U_NombreR&quot;, Nombre);&#xA;if (!string.IsNullOrEmpty(Almacen)) gd.SetProperty(&quot;U_Almacen_origen&quot;, Almacen);&#xA;gd.SetProperty(&quot;U_ESTADO&quot;, &quot;02&quot;);&#xA;gd.SetProperty(&quot;U_Tipo&quot;, &quot;02&quot;);&#xA;if (dtLineas.Rows[0][&quot;FechaEntrega&quot;] != DBNull.Value) gd.SetProperty(&quot;U_Fecha_Entrega&quot;, Convert.ToDateTime(dtLineas.Rows[0][&quot;FechaEntrega&quot;]));&#xA;SAPbobsCOM.GeneralDataCollection lines = gd.Child(&quot;CUADRO_RUTA_D&quot;);&#xA;int idx = 0;&#xA;foreach (System.Data.DataRow r in dtLineas.Rows) {&#xA;SAPbobsCOM.GeneralData ln = (lines.Count &gt; idx) ? lines.Item(idx) : lines.Add();&#xA;ln.SetProperty(&quot;U_No_OV&quot;, Convert.ToString(r[&quot;OV_Number&quot;]));&#xA;ln.SetProperty(&quot;U_Tipo_Documento&quot;, Convert.ToString(r[&quot;DocType&quot;]));&#xA;if (r[&quot;CodigoCliente&quot;] != DBNull.Value) ln.SetProperty(&quot;U_Codigo_Cliente&quot;, Convert.ToString(r[&quot;CodigoCliente&quot;]));&#xA;if (r[&quot;Direccion&quot;] != DBNull.Value) ln.SetProperty(&quot;U_Direccion&quot;, Convert.ToString(r[&quot;Direccion&quot;]));&#xA;if (r[&quot;Asesor&quot;] != DBNull.Value) ln.SetProperty(&quot;U_Asesor&quot;, Convert.ToString(r[&quot;Asesor&quot;]));&#xA;if (r[&quot;Comentario&quot;] != DBNull.Value) ln.SetProperty(&quot;U_Comentarios&quot;, Convert.ToString(r[&quot;Comentario&quot;]));&#xA;if (r[&quot;CentroCosto&quot;] != DBNull.Value) ln.SetProperty(&quot;U_Centro_Costo&quot;, Convert.ToString(r[&quot;CentroCosto&quot;]));&#xA;if (r[&quot;Peso&quot;] != DBNull.Value) ln.SetProperty(&quot;U_Peso_1&quot;, Math.Round(Convert.ToDecimal(r[&quot;Peso&quot;]), 2).ToString(&quot;F2&quot;));&#xA;idx++;&#xA;}&#xA;SAPbobsCOM.GeneralData res = gs.Add(gd);&#xA;int docEntry = Convert.ToInt32(res.GetProperty(&quot;DocEntry&quot;));&#xA;SAPbobsCOM.Recordset rs = (SAPbobsCOM.Recordset)ocompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);&#xA;rs.DoQuery(&quot;SELECT DocNum FROM [@CUADRO_RUTA_E] WHERE DocEntry=&quot; + docEntry);&#xA;realDocNum = Convert.ToInt32(rs.Fields.Item(&quot;DocNum&quot;).Value);&#xA;strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;DocNum &quot; + realDocNum;&#xA;}&#xA;} catch (Exception ex) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Catch: &quot; + ex.Message; }">
              <ui:InvokeCode.Arguments>
                <InOutArgument x:TypeArguments="s1:Company" x:Key="ocompany"><mca:CSharpReference x:TypeArguments="s1:Company">ocompany</mca:CSharpReference></InOutArgument>
                <InArgument x:TypeArguments="sd:DataTable" x:Key="dtLineas"><mca:CSharpValue x:TypeArguments="sd:DataTable">dtLineas</mca:CSharpValue></InArgument>
                <OutArgument x:TypeArguments="x:Int32" x:Key="realDocNum"><mca:CSharpReference x:TypeArguments="x:Int32">realDocNum</mca:CSharpReference></OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="strOutCode"><mca:CSharpReference x:TypeArguments="x:String">strOutCode</mca:CSharpReference></OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="strErrMsg"><mca:CSharpReference x:TypeArguments="x:String">strErrMsg</mca:CSharpReference></OutArgument>
              </ui:InvokeCode.Arguments>
            </ui:InvokeCode>

            <!-- Remapear provisional → DocNum real (cierra la orden CREATE) o marcar error -->
            <If DisplayName="Remapear o error">
              <If.Condition><InArgument x:TypeArguments="x:Boolean"><mca:CSharpValue x:TypeArguments="x:Boolean">strOutCode == &quot;SUCCESS&quot;</mca:CSharpValue></InArgument></If.Condition>
              <If.Then>
                <ui:ExecuteNonQuery CommandType="Text" DisplayName="SP_RemapComplemento">
                  <ui:ExecuteNonQuery.ExistingDbConnection>
                    <InArgument x:TypeArguments="ui:DatabaseConnection"><mca:CSharpValue x:TypeArguments="ui:DatabaseConnection">dbApp</mca:CSharpValue></InArgument>
                  </ui:ExecuteNonQuery.ExistingDbConnection>
                  <ui:ExecuteNonQuery.Parameters><scg:Dictionary x:TypeArguments="x:String, Argument" /></ui:ExecuteNonQuery.Parameters>
                  <ui:ExecuteNonQuery.Sql>
                    <InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String" xml:space="preserve">"EXEC dbo.SP_RemapComplemento " + cc["RouteNumber"].ToString() + ", " + realDocNum.ToString()</mca:CSharpValue></InArgument>
                  </ui:ExecuteNonQuery.Sql>
                </ui:ExecuteNonQuery>
              </If.Then>
              <If.Else>
                <ui:ExecuteNonQuery CommandType="Text" DisplayName="Marcar error CREATE">
                  <ui:ExecuteNonQuery.ExistingDbConnection>
                    <InArgument x:TypeArguments="ui:DatabaseConnection"><mca:CSharpValue x:TypeArguments="ui:DatabaseConnection">dbApp</mca:CSharpValue></InArgument>
                  </ui:ExecuteNonQuery.ExistingDbConnection>
                  <ui:ExecuteNonQuery.Parameters><scg:Dictionary x:TypeArguments="x:String, Argument" /></ui:ExecuteNonQuery.Parameters>
                  <ui:ExecuteNonQuery.Sql>
                    <InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String" xml:space="preserve">"UPDATE dbo.CuadroEdicionCola SET Estado='error', Error='" + strErrMsg.Replace("'","''") + "', Intentos=Intentos+1 WHERE ID_Edicion=" + cc["ID_Edicion"].ToString()</mca:CSharpValue></InArgument>
                  </ui:ExecuteNonQuery.Sql>
                </ui:ExecuteNonQuery>
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>

    <!-- 3) Leer ediciones pendientes de PLACA/REMOVE/ADD -->
    <ui:ExecuteQuery CommandType="Text" DisplayName="Leer pendientes" Sql="SELECT ID_Edicion, RouteNumber, CuadroDocEntry, Accion, OV_Number, DocType, Placa, Capacidad, IDCamion, Transportista, CardCode, LineaCodigoCliente, LineaDireccion, LineaPeso, LineaAsesor, LineaComentario, LineaCentroCosto FROM dbo.vw_CuadroEdicionPendiente WHERE Accion IN ('PLACA','REMOVE','ADD') AND CuadroDocEntry IS NOT NULL ORDER BY ID_Edicion">
      <ui:ExecuteQuery.DataTable>
        <OutArgument x:TypeArguments="sd:DataTable">
          <mca:CSharpReference x:TypeArguments="sd:DataTable">dtPend</mca:CSharpReference>
        </OutArgument>
      </ui:ExecuteQuery.DataTable>
      <ui:ExecuteQuery.ExistingDbConnection>
        <InArgument x:TypeArguments="ui:DatabaseConnection">
          <mca:CSharpValue x:TypeArguments="ui:DatabaseConnection">dbApp</mca:CSharpValue>
        </InArgument>
      </ui:ExecuteQuery.ExistingDbConnection>
      <ui:ExecuteQuery.Parameters>
        <scg:Dictionary x:TypeArguments="x:String, Argument" />
      </ui:ExecuteQuery.Parameters>
    </ui:ExecuteQuery>

    <!-- 4) Por cada pendiente -->
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DisplayName="Recorrer pendientes">
      <ui:ForEachRow.DataTable>
        <InArgument x:TypeArguments="sd:DataTable">
          <mca:CSharpValue x:TypeArguments="sd:DataTable">dtPend</mca:CSharpValue>
        </InArgument>
      </ui:ForEachRow.DataTable>
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="ch" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <Assign DisplayName="reset outcome">
              <Assign.To><OutArgument x:TypeArguments="x:String"><mca:CSharpReference x:TypeArguments="x:String">strOutCode</mca:CSharpReference></OutArgument></Assign.To>
              <Assign.Value><InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">&quot;&quot;</mca:CSharpValue></InArgument></Assign.Value>
            </Assign>

            <!-- Switch por Acción (hoy solo PLACA; agregar REMOVE/ADD como casos nuevos) -->
            <Switch x:TypeArguments="x:String" DisplayName="Switch Accion">
              <Switch.Expression>
                <InArgument x:TypeArguments="x:String">
                  <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;Accion&quot;].ToString()</mca:CSharpValue>
                </InArgument>
              </Switch.Expression>

              <ui:InvokeCode x:Key="PLACA" DisplayName="Aplicar PLACA (UDO Cuadro_ruta)" Language="CSharp" Code="try {&#xA;SAPbobsCOM.CompanyService cs = ocompany.GetCompanyService();&#xA;SAPbobsCOM.GeneralService gs = cs.GetGeneralService(&quot;Cuadro_ruta&quot;);&#xA;SAPbobsCOM.GeneralDataParams prm = (SAPbobsCOM.GeneralDataParams)gs.GetDataInterface(SAPbobsCOM.GeneralServiceDataInterfaces.gsGeneralDataParams);&#xA;prm.SetProperty(&quot;DocEntry&quot;, DocEntry);&#xA;SAPbobsCOM.GeneralData gd = gs.GetByParams(prm);&#xA;if (gd == null) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Cuadro no encontrado DocEntry &quot; + DocEntry; }&#xA;else {&#xA;string placaActual = Convert.ToString(gd.GetProperty(&quot;U_Placa&quot;));&#xA;if (!string.IsNullOrEmpty(placaActual) &amp;&amp; placaActual.Trim() != &quot;&quot;) { strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;SAP ya tenia placa &quot; + placaActual; }&#xA;else {&#xA;gd.SetProperty(&quot;U_Placa&quot;, Placa);&#xA;if (!string.IsNullOrEmpty(IDCamion)) gd.SetProperty(&quot;U_ID_Camion&quot;, IDCamion);&#xA;if (!string.IsNullOrEmpty(CardCode)) gd.SetProperty(&quot;U_CardCode&quot;, CardCode);&#xA;double capNum;&#xA;if (double.TryParse(Capacidad, out capNum)) gd.SetProperty(&quot;U_Capacidad&quot;, capNum);&#xA;gs.Update(gd);&#xA;strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;&quot;;&#xA;}&#xA;}&#xA;} catch (Exception ex) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Catch: &quot; + ex.Message; }">
                <ui:InvokeCode.Arguments>
                  <InOutArgument x:TypeArguments="s1:Company" x:Key="ocompany">
                    <mca:CSharpReference x:TypeArguments="s1:Company">ocompany</mca:CSharpReference>
                  </InOutArgument>
                  <InArgument x:TypeArguments="x:Int32" x:Key="DocEntry">
                    <mca:CSharpValue x:TypeArguments="x:Int32">Convert.ToInt32(ch[&quot;CuadroDocEntry&quot;])</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Placa">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;Placa&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="IDCamion">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;IDCamion&quot;] == null ? &quot;&quot; : ch[&quot;IDCamion&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Capacidad">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;Capacidad&quot;] == null ? &quot;&quot; : ch[&quot;Capacidad&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="CardCode">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;CardCode&quot;] == null ? &quot;&quot; : ch[&quot;CardCode&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="strOutCode">
                    <mca:CSharpReference x:TypeArguments="x:String">strOutCode</mca:CSharpReference>
                  </OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="strErrMsg">
                    <mca:CSharpReference x:TypeArguments="x:String">strErrMsg</mca:CSharpReference>
                  </OutArgument>
                </ui:InvokeCode.Arguments>
              </ui:InvokeCode>

              <ui:InvokeCode x:Key="REMOVE" DisplayName="Aplicar REMOVE (quitar línea del UDO)" Language="CSharp" Code="try {&#xA;SAPbobsCOM.GeneralService gs = ocompany.GetCompanyService().GetGeneralService(&quot;Cuadro_ruta&quot;);&#xA;SAPbobsCOM.GeneralDataParams prm = (SAPbobsCOM.GeneralDataParams)gs.GetDataInterface(SAPbobsCOM.GeneralServiceDataInterfaces.gsGeneralDataParams);&#xA;prm.SetProperty(&quot;DocEntry&quot;, DocEntry);&#xA;SAPbobsCOM.GeneralData gd = gs.GetByParams(prm);&#xA;if (gd == null) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Cuadro no encontrado DocEntry &quot; + DocEntry; }&#xA;else {&#xA;SAPbobsCOM.GeneralDataCollection lines = gd.Child(&quot;CUADRO_RUTA_D&quot;);&#xA;int idx = -1;&#xA;for (int i = 0; i &lt; lines.Count; i++) {&#xA;SAPbobsCOM.GeneralData ln = lines.Item(i);&#xA;string ov = Convert.ToString(ln.GetProperty(&quot;U_No_OV&quot;));&#xA;string tp = Convert.ToString(ln.GetProperty(&quot;U_Tipo_Documento&quot;));&#xA;bool okTipo = string.IsNullOrEmpty(Tipo) || string.Equals((tp ?? &quot;&quot;).Trim(), Tipo.Trim(), StringComparison.OrdinalIgnoreCase);&#xA;if (ov != null &amp;&amp; ov.Trim() == OV.Trim() &amp;&amp; okTipo) { idx = i; break; }&#xA;}&#xA;if (idx &lt; 0) { strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;La linea ya no estaba&quot;; }&#xA;else if (lines.Count &lt;= 1) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;No se quita: dejaria el cuadro sin lineas&quot;; }&#xA;else { lines.Remove(idx); gs.Update(gd); strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;&quot;; }&#xA;}&#xA;} catch (Exception ex) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Catch: &quot; + ex.Message; }">
                <ui:InvokeCode.Arguments>
                  <InOutArgument x:TypeArguments="s1:Company" x:Key="ocompany">
                    <mca:CSharpReference x:TypeArguments="s1:Company">ocompany</mca:CSharpReference>
                  </InOutArgument>
                  <InArgument x:TypeArguments="x:Int32" x:Key="DocEntry">
                    <mca:CSharpValue x:TypeArguments="x:Int32">Convert.ToInt32(ch[&quot;CuadroDocEntry&quot;])</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="OV">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;OV_Number&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Tipo">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;DocType&quot;] == null ? &quot;&quot; : ch[&quot;DocType&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="strOutCode">
                    <mca:CSharpReference x:TypeArguments="x:String">strOutCode</mca:CSharpReference>
                  </OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="strErrMsg">
                    <mca:CSharpReference x:TypeArguments="x:String">strErrMsg</mca:CSharpReference>
                  </OutArgument>
                </ui:InvokeCode.Arguments>
              </ui:InvokeCode>

              <ui:InvokeCode x:Key="ADD" DisplayName="Aplicar ADD (agregar línea al UDO)" Language="CSharp" Code="try {&#xA;SAPbobsCOM.GeneralService gs = ocompany.GetCompanyService().GetGeneralService(&quot;Cuadro_ruta&quot;);&#xA;SAPbobsCOM.GeneralDataParams prm = (SAPbobsCOM.GeneralDataParams)gs.GetDataInterface(SAPbobsCOM.GeneralServiceDataInterfaces.gsGeneralDataParams);&#xA;prm.SetProperty(&quot;DocEntry&quot;, DocEntry);&#xA;SAPbobsCOM.GeneralData gd = gs.GetByParams(prm);&#xA;if (gd == null) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Cuadro no encontrado DocEntry &quot; + DocEntry; }&#xA;else {&#xA;SAPbobsCOM.GeneralDataCollection lines = gd.Child(&quot;CUADRO_RUTA_D&quot;);&#xA;bool existe = false;&#xA;for (int i = 0; i &lt; lines.Count; i++) {&#xA;SAPbobsCOM.GeneralData ln = lines.Item(i);&#xA;string ov = Convert.ToString(ln.GetProperty(&quot;U_No_OV&quot;));&#xA;string tp = Convert.ToString(ln.GetProperty(&quot;U_Tipo_Documento&quot;));&#xA;if (ov != null &amp;&amp; ov.Trim() == OV.Trim() &amp;&amp; string.Equals((tp ?? &quot;&quot;).Trim(), Tipo.Trim(), StringComparison.OrdinalIgnoreCase)) { existe = true; break; }&#xA;}&#xA;if (existe) { strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;La linea ya estaba&quot;; }&#xA;else {&#xA;SAPbobsCOM.GeneralData nl = lines.Add();&#xA;nl.SetProperty(&quot;U_No_OV&quot;, OV);&#xA;nl.SetProperty(&quot;U_Tipo_Documento&quot;, Tipo);&#xA;if (!string.IsNullOrEmpty(CodCliente)) nl.SetProperty(&quot;U_Codigo_Cliente&quot;, CodCliente);&#xA;if (!string.IsNullOrEmpty(Direccion)) nl.SetProperty(&quot;U_Direccion&quot;, Direccion);&#xA;if (!string.IsNullOrEmpty(Asesor)) nl.SetProperty(&quot;U_Asesor&quot;, Asesor);&#xA;if (!string.IsNullOrEmpty(Comentario)) nl.SetProperty(&quot;U_Comentarios&quot;, Comentario);&#xA;if (!string.IsNullOrEmpty(Centro)) nl.SetProperty(&quot;U_Centro_Costo&quot;, Centro);&#xA;double pesoNum;&#xA;if (double.TryParse(Peso, out pesoNum)) nl.SetProperty(&quot;U_Peso_1&quot;, Math.Round((decimal)pesoNum, 2).ToString(&quot;F2&quot;));&#xA;gs.Update(gd);&#xA;strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;&quot;;&#xA;}&#xA;}&#xA;} catch (Exception ex) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Catch: &quot; + ex.Message; }">
                <ui:InvokeCode.Arguments>
                  <InOutArgument x:TypeArguments="s1:Company" x:Key="ocompany">
                    <mca:CSharpReference x:TypeArguments="s1:Company">ocompany</mca:CSharpReference>
                  </InOutArgument>
                  <InArgument x:TypeArguments="x:Int32" x:Key="DocEntry">
                    <mca:CSharpValue x:TypeArguments="x:Int32">Convert.ToInt32(ch[&quot;CuadroDocEntry&quot;])</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="OV">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;OV_Number&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Tipo">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;DocType&quot;] == null ? &quot;&quot; : ch[&quot;DocType&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="CodCliente">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;LineaCodigoCliente&quot;] == null ? &quot;&quot; : ch[&quot;LineaCodigoCliente&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Direccion">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;LineaDireccion&quot;] == null ? &quot;&quot; : ch[&quot;LineaDireccion&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Asesor">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;LineaAsesor&quot;] == null ? &quot;&quot; : ch[&quot;LineaAsesor&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Comentario">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;LineaComentario&quot;] == null ? &quot;&quot; : ch[&quot;LineaComentario&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Centro">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;LineaCentroCosto&quot;] == null ? &quot;&quot; : ch[&quot;LineaCentroCosto&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Peso">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;LineaPeso&quot;] == null ? &quot;&quot; : ch[&quot;LineaPeso&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="strOutCode">
                    <mca:CSharpReference x:TypeArguments="x:String">strOutCode</mca:CSharpReference>
                  </OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="strErrMsg">
                    <mca:CSharpReference x:TypeArguments="x:String">strErrMsg</mca:CSharpReference>
                  </OutArgument>
                </ui:InvokeCode.Arguments>
              </ui:InvokeCode>
            </Switch>

            <!-- 5) Marcar resultado en el outbox (el reconciliador del app cierra el lazo) -->
            <If DisplayName="Marcar resultado">
              <If.Condition>
                <InArgument x:TypeArguments="x:Boolean">
                  <mca:CSharpValue x:TypeArguments="x:Boolean">strOutCode == &quot;SUCCESS&quot;</mca:CSharpValue>
                </InArgument>
              </If.Condition>
              <If.Then>
                <ui:ExecuteNonQuery CommandType="Text" DisplayName="Marcar confirmado">
                  <ui:ExecuteNonQuery.ExistingDbConnection>
                    <InArgument x:TypeArguments="ui:DatabaseConnection">
                      <mca:CSharpValue x:TypeArguments="ui:DatabaseConnection">dbApp</mca:CSharpValue>
                    </InArgument>
                  </ui:ExecuteNonQuery.ExistingDbConnection>
                  <ui:ExecuteNonQuery.Parameters>
                    <scg:Dictionary x:TypeArguments="x:String, Argument" />
                  </ui:ExecuteNonQuery.Parameters>
                  <ui:ExecuteNonQuery.Sql>
                    <InArgument x:TypeArguments="x:String">
                      <mca:CSharpValue x:TypeArguments="x:String" xml:space="preserve">"UPDATE dbo.CuadroEdicionCola SET Estado='confirmado', FechaSync=GETDATE() WHERE ID_Edicion=" + ch["ID_Edicion"].ToString()</mca:CSharpValue>
                    </InArgument>
                  </ui:ExecuteNonQuery.Sql>
                </ui:ExecuteNonQuery>
              </If.Then>
              <If.Else>
                <If DisplayName="¿Error?">
                  <If.Condition>
                    <InArgument x:TypeArguments="x:Boolean">
                      <mca:CSharpValue x:TypeArguments="x:Boolean">strOutCode == &quot;ERROR&quot;</mca:CSharpValue>
                    </InArgument>
                  </If.Condition>
                  <If.Then>
                    <ui:ExecuteNonQuery CommandType="Text" DisplayName="Marcar error">
                      <ui:ExecuteNonQuery.ExistingDbConnection>
                        <InArgument x:TypeArguments="ui:DatabaseConnection">
                          <mca:CSharpValue x:TypeArguments="ui:DatabaseConnection">dbApp</mca:CSharpValue>
                        </InArgument>
                      </ui:ExecuteNonQuery.ExistingDbConnection>
                      <ui:ExecuteNonQuery.Parameters>
                        <scg:Dictionary x:TypeArguments="x:String, Argument" />
                      </ui:ExecuteNonQuery.Parameters>
                      <ui:ExecuteNonQuery.Sql>
                        <InArgument x:TypeArguments="x:String">
                          <mca:CSharpValue x:TypeArguments="x:String" xml:space="preserve">"UPDATE dbo.CuadroEdicionCola SET Estado='error', Error='" + strErrMsg.Replace("'","''") + "', Intentos=Intentos+1 WHERE ID_Edicion=" + ch["ID_Edicion"].ToString()</mca:CSharpValue>
                        </InArgument>
                      </ui:ExecuteNonQuery.Sql>
                    </ui:ExecuteNonQuery>
                  </If.Then>
                </If>
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>

