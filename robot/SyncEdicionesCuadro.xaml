              <ui:InvokeCode x:Key="PLACA" DisplayName="Aplicar PLACA (UDO Cuadro_ruta)" Language="CSharp" Code="try {&#xA;SAPbobsCOM.CompanyService cs = ocompany.GetCompanyService();&#xA;SAPbobsCOM.GeneralService gs = cs.GetGeneralService(&quot;Cuadro_ruta&quot;);&#xA;SAPbobsCOM.GeneralDataParams prm = (SAPbobsCOM.GeneralDataParams)gs.GetDataInterface(SAPbobsCOM.GeneralServiceDataInterfaces.gsGeneralDataParams);&#xA;prm.SetProperty(&quot;DocEntry&quot;, DocEntry);&#xA;SAPbobsCOM.GeneralData gd = gs.GetByParams(prm);&#xA;if (gd == null) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Cuadro no encontrado DocEntry &quot; + DocEntry; }&#xA;else {&#xA;string placaActual = Convert.ToString(gd.GetProperty(&quot;U_Placa&quot;));&#xA;if (!string.IsNullOrEmpty(placaActual) &amp;&amp; placaActual.Trim() != &quot;&quot;) { strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;SAP ya tenia placa &quot; + placaActual; }&#xA;else {&#xA;gd.SetProperty(&quot;U_Placa&quot;, Placa);&#xA;if (!string.IsNullOrEmpty(IDCamion)) gd.SetProperty(&quot;U_ID_Camion&quot;, IDCamion);&#xA;if (!string.IsNullOrEmpty(CardCode)) gd.SetProperty(&quot;U_CardCode&quot;, CardCode);&#xA;double capNum;&#xA;if (double.TryParse(Capacidad, out capNum)) gd.SetProperty(&quot;U_Capacidad&quot;, capNum);&#xA;gs.Update(gd);&#xA;strOutCode = &quot;SUCCESS&quot;; strErrMsg = &quot;&quot;;&#xA;}&#xA;}&#xA;} catch (Exception ex) { strOutCode = &quot;ERROR&quot;; strErrMsg = &quot;Catch: &quot; + ex.Message; }">
                <ui:InvokeCode.Arguments>
                  <InOutArgument x:TypeArguments="s1:Company" x:Key="ocompany">
                    <mca:CSharpReference x:TypeArguments="s1:Company">ocompany</mca:CSharpReference>
                  </InOutArgument>
                  <InArgument x:TypeArguments="x:Int32" x:Key="DocEntry">
                    <mca:CSharpValue x:TypeArguments="x:Int32">Convert.ToInt32(ch[&quot;CuadroDocEntry&quot;])</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Placa">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;Placa&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="IDCamion">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;IDCamion&quot;] == null ? &quot;&quot; : ch[&quot;IDCamion&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="Capacidad">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;Capacidad&quot;] == null ? &quot;&quot; : ch[&quot;Capacidad&quot;].ToString()</mca:CSharpValue>
                  </InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="CardCode">
                    <mca:CSharpValue x:TypeArguments="x:String">ch[&quot;CardCode&quot;] == null ? &quot;&quot; : ch[&quot;CardCode&quot;].ToString()</mca:CSharpValue>
