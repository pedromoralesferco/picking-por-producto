    <ui:InvokeCode DisplayName="Desconectarse SAP" Language="CSharp" Code="if (ocompany != null &amp;&amp; ocompany.Connected) ocompany.Disconnect();">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="s1:Company" x:Key="ocompany">
