# ============================================================
# Config del robot SyncEdicionesCuadro — LLENAR y renombrar a
#   SyncEdicionesCuadro.Config.env   (ese NO se sube a git)
# ============================================================
# Son 3 pares de credenciales + el entorno. El .xaml tiene 6
# placeholders que se reemplazan con estos valores.
#
#  1) SQL login del OUTBOX  -> SERVER-APPS-TAB / Picking_Management
#     Debe tener acceso TAMBIEN al linked server [server-sql]
#     (lo usa la vista para resolver CuadroDocEntry).
SQL_USER=
SQL_PASS=

#  2) Login de la BD de SAP (DbUserName/DbPassword de la Company DB)
#     Es el usuario SQL con el que SAP abre SBOFERCO (NO el usuario B1).
DB_USER=
DB_PASS=

#  3) Usuario de aplicacion SAP Business One (el que ve licencia)
SAP_USER=
SAP_PASS=

# ------------------------------------------------------------
# ENTORNO: PRD o QA. Define a que SAP/SQL apunta el robot.
#   PRD -> SAP server-sql.ferco.com.gt / CompanyDB SBOFERCO
#          Outbox  SERVER-APPS-TAB / Picking_Management
#   QA  -> SAP SANDOBOX-SAP        / CompanyDB SBOFERCO_SANDBOX
#          (probar aqui primero)
ENTORNO=QA

# Endpoints (no cambiar salvo que migren el server):
SAP_SERVER_PRD=server-sql.ferco.com.gt
SAP_COMPANYDB_PRD=SBOFERCO
SAP_SERVER_QA=SANDOBOX-SAP
SAP_COMPANYDB_QA=SBOFERCO_SANDBOX
SAP_SLD=https://server-sapbo.ferco.com.gt:40000
OUTBOX_SERVER=SERVER-APPS-TAB
OUTBOX_DB=Picking_Management
